//===----------------------------------------------------------------------===//
//
// This file is used as the registry of passes that are part of the
// AMDGPU backend.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef MODULE_PASS
#define MODULE_PASS(NAME, CREATE_PASS)
#endif
MODULE_PASS("orisc-transform-indices", TransformStructIndicesPass())
MODULE_PASS("orisc-transform-load-store-pointer", TransformLoadStorePointerPass())
MODULE_PASS("orisc-move-alloca-on-heap", MoveAllocaOnHeapPass())
#undef MODULE_PASS

#ifndef FUNCTION_PASS
#define FUNCTION_PASS(NAME, CREATE_PASS)
#endif
FUNCTION_PASS("orisc-eliminate-pointer-redundancies", EliminatePointerRedundanciesPass())
FUNCTION_PASS("orisc-reject-unsupported-ir", RejectUnsupportedIRPass())
#undef FUNCTION_PASS